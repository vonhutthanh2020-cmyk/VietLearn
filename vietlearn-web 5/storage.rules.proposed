// ĐỀ XUẤT – CHƯA KIỂM THỬ. Ảnh hồ sơ nhà phát hành: chỉ nhà phát hành có phiên hợp lệ được ghi; ảnh JPG/PNG/WebP ≤ 2 MB.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /publisher/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.pub == true && request.auth.token.pubExp > request.time.toMillis()
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
